<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dm</groupId>
    <artifactId>dungeon-master</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Target 21 once a JDK 21 is installed; 17 is what this machine has. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <main.class>dm.Main</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- target/dungeon-master.jar whatever the version, so run commands don't go stale; releases add the version -->
        <finalName>dungeon-master</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            mvn package -Pdist: a Windows zip with DungeonMaster.exe and its own trimmed Java runtime
            (jpackage app-image, java.base + java.desktop), empty data\ and saves\ folders and readme.txt.
            Needs a JDK with jpackage (14+) on Windows. The launcher points the game at data\ and saves\
            beside the exe ($APPDIR is the image's app\ folder), wherever it is started from.
        -->
        <profile>
            <id>dist</id>
            <properties>
                <dist.name>DungeonMaster</dist.name>
                <dist.dir>${project.build.directory}/dist</dist.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <!-- parsedVersion.*: the project version without -SNAPSHOT, as jpackage wants it -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>parse-version</id>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>dist-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <property name="dist.version"
                                                  value="${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}"/>
                                        <delete dir="${dist.dir}"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${dist.dir}/input"/>
                                        <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="app-image"/>
                                            <arg value="--name"/>
                                            <arg value="${dist.name}"/>
                                            <arg value="--app-version"/>
                                            <arg value="${dist.version}"/>
                                            <arg value="--input"/>
                                            <arg value="${dist.dir}/input"/>
                                            <arg value="--main-jar"/>
                                            <arg value="${project.build.finalName}.jar"/>
                                            <arg value="--main-class"/>
                                            <arg value="${main.class}"/>
                                            <arg value="--add-modules"/>
                                            <arg value="java.base,java.desktop"/>
                                            <arg value="--java-options"/>
                                            <arg value="-Ddm.dungeon=$APPDIR\..\data\DUNGEON.DAT"/>
                                            <arg value="--java-options"/>
                                            <arg value="-Ddm.saves=$APPDIR\..\saves"/>
                                            <arg value="--dest"/>
                                            <arg value="${dist.dir}/image"/>
                                        </exec>
                                        <mkdir dir="${dist.dir}/image/${dist.name}/data"/>
                                        <mkdir dir="${dist.dir}/image/${dist.name}/saves"/>
                                        <copy file="${project.basedir}/src/dist/readme.txt"
                                              todir="${dist.dir}/image/${dist.name}"/>
                                        <zip destfile="${project.build.directory}/${dist.name}-${dist.version}-windows.zip"
                                             basedir="${dist.dir}/image"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
